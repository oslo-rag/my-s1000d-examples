  <content>
    <procedural>
      <title>Replace Oslo Radar Antenna</title>
      <preliminaryRequirements>
        <reqCondGroup>
          <reqCond>Power to radar unit is OFF.</reqCond>
        </reqCondGroup>
      </preliminaryRequirements>
      <procedure>
        <step>
          <para>Remove the four mounting bolts from the antenna base.</para>
        </step>
        <step>
          <para>Disconnect the coaxial cable connector.</para>
        </step>
        <step>
          <para>Install the new antenna and torque bolts to 12 Nm.</para>
        </step>
        <step>
          <para>Reconnect the coaxial cable.</para>
        </step>
      </procedure>
      <concludingInformation>
        <para>Perform functional test after replacement.</para>
      </concludingInformation>
    </procedural>
  </content>
